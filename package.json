{
  "name": "arc-image-studio",
  "version": "2.2.0",
  "description": "Compressor e redimensionador de imagens em lote, com presets para redes sociais.",
  "type": "module",
  "main": "src/main.mjs",
  "author": "ARC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "generate:assets": "node scripts/generate-animations.mjs",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "gifenc": "^1.0.3"
  },
  "build": {
    "appId": "com.arc.imagestudio",
    "productName": "ARC Image Studio",
    "asar": true,
    "asarUnpack": [
      "vendor/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARC Image Studio"
    }
  }
}
